{
  "name": "solvia",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "pnpm --filter \"@solvia/messenger-*\" dev",
    "build": "pnpm --filter \"@solvia/messenger-*\" build",
    "lint": "eslint \"apps/messenger/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"apps/messenger/**/*.{ts,tsx}\" --fix",
    "clean": "pnpm --filter \"@solvia/messenger-*\" clean"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^8.56.0",
    "eslint-config-next": "^15.1.4",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3"
  }
}
